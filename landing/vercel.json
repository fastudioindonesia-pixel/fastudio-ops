{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ops", "destination": "/signin" },
    { "source": "/booking", "destination": "/signin" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
